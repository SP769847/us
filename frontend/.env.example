# Leave unset for local dev — Vite's proxy (vite.config.js) forwards relative
# /api and /socket.io calls to http://localhost:4000 automatically.
#
# Set this in Vercel's project environment variables for production, pointing
# at your deployed Render backend (no trailing slash):
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
