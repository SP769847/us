// Prisma schema — MySQL wire protocol (TiDB Cloud / MySQL / PlanetScale-compatible).
// For local dev without a hosted DB, run `docker compose up -d` at the repo root
// for a local MySQL instance (see backend/.env.example for the matching DATABASE_URL).
//
// relationMode = "prisma" makes Prisma enforce referential actions (cascades,
// etc.) at the query-engine level instead of relying on native DB foreign key
// constraints. This is the standard, Prisma-recommended setting for
// TiDB/PlanetScale-style distributed MySQL databases. It requires an index on
// every relation scalar field that doesn't already have one as the leftmost
// column of another index — all such fields below are indexed accordingly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Enums are plain Strings validated in the application layer (see
// src/utils/validators.js and per-controller allow-lists) rather than native
// Prisma enums, since the project started on SQLite (no enum support) and this
// keeps a single schema portable across providers. Values used:
//   User.role: "USER" | "ADMIN"
//   User.status: "ACTIVE" | "SUSPENDED"
//   ConnectionRequest.status: "PENDING" | "ACCEPTED" | "DECLINED"
//   Message.type: "TEXT" | "IMAGE" | "EMOJI" | "SYSTEM" | "QUESTION"
//   Report.status: "PENDING" | "RESOLVED" | "DISMISSED"
//   Question.category / SentQuestion.category: "ROMANTIC" | "CUTE" | "FUNNY" | "DEEP" | "NAUGHTY_18" | "RANDOM"
//   Question.subcategory / SentQuestion.subcategory (NAUGHTY_18 only): "ATTRACTION" | "SEXUAL_PREFERENCES" |
//     "FANTASIES_CURIOSITY" | "PERSONAL_EXPERIENCE" | "INTIMACY_RELATIONSHIP" | "BOUNDARIES_PREFERENCES" |
//     "COUPLE_CONFESSIONS" | "FLIRTY_COUPLE" | "PERSONAL_RATING" | "TURN_ONS"
//   Question.intimacyLevel / SentQuestion.intimacyLevel (NAUGHTY_18 only): "ROMANTIC" | "FLIRTY" | "INTIMATE" | "DEEPLY_PERSONAL"
//   Question.responseType / SentQuestion.responseType: "TEXT" | "MULTIPLE_CHOICE" | "YES_NO" | "SCALE_1_10"
//   SentQuestion.mode: "SURPRISE" | "ASK_ME_ANYTHING" | "ANSWER_TOGETHER"
//   User.questionPreference: "CUTE" | "ROMANTIC" | "FLIRTY" | "INTIMATE" | "EXPLICIT_18"
//   CustomQuestion.visibility: "PRIVATE" | "PARTNER"

model User {
  id                 String   @id @default(uuid())
  fullName           String
  username           String   @unique
  email              String   @unique
  passwordHash       String
  avatarUrl          String?
  bio                String?  @db.Text
  role               String   @default("USER")
  status             String   @default("ACTIVE")
  lastSeenAt         DateTime @default(now())
  isOnline           Boolean  @default(false)
  questionPreference String   @default("ROMANTIC") // CUTE | ROMANTIC | FLIRTY | INTIMATE | EXPLICIT_18 — Surprise Me content level
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sentRequests            ConnectionRequest[]  @relation("SentRequests")
  receivedRequests        ConnectionRequest[]  @relation("ReceivedRequests")
  connectionsA            Connection[]         @relation("ConnectionUserA")
  connectionsB            Connection[]         @relation("ConnectionUserB")
  blocksInitiated         BlockedUser[]        @relation("Blocker")
  blocksReceived          BlockedUser[]        @relation("Blocked")
  reportsFiled            Report[]             @relation("ReportedBy")
  reportsAgainst          Report[]             @relation("ReportedUser")
  conversationMembers     ConversationMember[]
  messagesSent            Message[]            @relation("MessageSender")
  messageReactions        MessageReaction[]
  messagePins             MessagePin[]
  loveNotesSent           LoveNote[]           @relation("LoveNoteSender")
  loveNotesReceived       LoveNote[]           @relation("LoveNoteRecipient")
  secretMessagesSent      SecretMessage[]      @relation("SecretSender")
  secretMessagesReceived  SecretMessage[]      @relation("SecretRecipient")
  dailyQuestionAnswers    QuestionAnswer[]
  sentQuestionsSent       SentQuestion[]       @relation("SentQuestionSender")
  sentQuestionsReceived   SentQuestion[]       @relation("SentQuestionRecipient")
  savedQuestions          SavedQuestion[]
  seenQuestions           SeenQuestion[]
  customQuestionsAuthored CustomQuestion[]     @relation("CustomQuestionAuthor")
  customQuestionsReceived CustomQuestion[]     @relation("CustomQuestionRecipient")
  challengesSent          Challenge[]          @relation("ChallengeSender")
  challengesReceived      Challenge[]          @relation("ChallengeRecipient")
  challengeResponses      ChallengeResponse[]
  gameSessions            GameSession[]        @relation("GameInitiator")
  memories                Memory[]
  timelineEvents          TimelineEvent[]
  specialDates            SpecialDate[]
  notifications           Notification[]       @relation("NotificationRecipient")
  passwordResetTokens     PasswordResetToken[]

  @@index([username])
  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ConnectionRequest {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  status      String   @default("PENDING")
  message     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sender    User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedRequests", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, recipientId])
  @@index([recipientId])
}

model Connection {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("ConnectionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("ConnectionUserB", fields: [userBId], references: [id], onDelete: Cascade)

  conversation Conversation?

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  reason    String?  @db.Text
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id             String    @id @default(uuid())
  reporterId     String
  reportedId     String
  reason         String
  details        String?   @db.Text
  status         String    @default("PENDING")
  resolutionNote String?   @db.Text
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  reporter User @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportedUser", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedId])
  @@index([status])
}

model Conversation {
  id           String   @id @default(uuid())
  connectionId String   @unique
  createdAt    DateTime @default(now())

  connection    Connection           @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  members       ConversationMember[]
  messages      Message[]
  sentQuestions SentQuestion[]
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  type           String    @default("TEXT")
  content        String?   @db.Text
  attachmentUrl  String?
  replyToId      String?
  isDeleted      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies      Message[]         @relation("MessageReplies")
  reactions    MessageReaction[]
  pins         MessagePin[]
  sentQuestion SentQuestion?

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([userId])
}

model MessagePin {
  id         String   @id @default(uuid())
  messageId  String
  pinnedById String
  createdAt  DateTime @default(now())

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy User    @relation(fields: [pinnedById], references: [id], onDelete: Cascade)

  @@unique([messageId])
  @@index([pinnedById])
}

model LoveNote {
  id          String    @id @default(uuid())
  senderId    String
  recipientId String
  kind        String    @default("LOVE_NOTE") // LOVE_NOTE | READ_THIS_WHEN
  category    String? // for READ_THIS_WHEN: SAD, MISS_ME, ANGRY, CANT_SLEEP, NEED_LOVE, MOTIVATION, CUSTOM
  title       String
  message     String    @db.Text
  imageUrl    String?
  unlockAt    DateTime?
  createdAt   DateTime  @default(now())

  sender    User @relation("LoveNoteSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("LoveNoteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
}

model SecretMessage {
  id           String    @id @default(uuid())
  senderId     String
  recipientId  String
  content      String    @db.Text
  passcodeHash String?
  unlockAt     DateTime?
  openedAt     DateTime?
  createdAt    DateTime  @default(now())

  sender    User @relation("SecretSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("SecretRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
}

model DailyQuestion {
  id        String   @id @default(uuid())
  prompt    String
  category  String?
  createdAt DateTime @default(now())

  answers QuestionAnswer[]
}

model QuestionAnswer {
  id               String   @id @default(uuid())
  questionId       String
  userId           String
  answer           String   @db.Text
  sharedWithUserId String?
  createdAt        DateTime @default(now())

  question DailyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId])
  @@index([sharedWithUserId])
}

// Couple Questions bank (Romantic / Cute / Funny / Deep / Naughty 18+ / Random),
// distinct from the single DailyQuestion-of-the-day feature above. Rows are
// seeded from src/utils/contentBanks.js on server startup (see
// src/utils/seedQuestions.js) so new questions can be added without touching
// the frontend.
model Question {
  id            String   @id @default(uuid())
  category      String
  subcategory   String? // NAUGHTY_18 only — see contentBanks.js NAUGHTY_SUBCATEGORIES
  intimacyLevel String? // NAUGHTY_18 only: ROMANTIC | FLIRTY | INTIMATE | DEEPLY_PERSONAL — "how personal" depth dial, independent of subcategory theme
  questionText  String   @db.VarChar(500)
  responseType  String   @default("TEXT") // TEXT | MULTIPLE_CHOICE | YES_NO | SCALE_1_10
  options       String?  @db.Text // JSON array of strings, MULTIPLE_CHOICE only
  ageRestricted Boolean  @default(false)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sentQuestions SentQuestion[]
  savedByUsers  SavedQuestion[]
  seenByUsers   SeenQuestion[]

  @@unique([category, questionText])
  @@index([category])
  @@index([subcategory])
  @@index([intimacyLevel])
}

// A question (from the bank, a custom "Ask Me Anything" prompt, or a
// Personalization custom question) sent by one partner to the other inside a
// conversation. Always rendered as its own special message card
// (Message.type = "QUESTION") rather than plain text. Visible only to the
// sender and recipient — never surfaced in public profiles, search,
// discover, or admin statistics.
model SentQuestion {
  id                 String    @id @default(uuid())
  questionId         String?
  customText         String?   @db.Text
  mode               String    @default("SURPRISE") // SURPRISE | ASK_ME_ANYTHING | ANSWER_TOGETHER
  category           String?
  subcategory        String?
  intimacyLevel      String?
  responseType       String    @default("TEXT")
  options            String?   @db.Text
  conversationId     String
  messageId          String    @unique
  senderId           String
  recipientId        String
  revealed           Boolean   @default(true)
  answer             String?   @db.Text // the recipient's answer (SURPRISE/ASK_ME_ANYTHING), or ANSWER_TOGETHER's recipient-side slot
  answeredById       String?
  answeredAt         DateTime?
  senderAnswer       String?   @db.Text // ANSWER_TOGETHER only — the sender's own answer, given at send time
  senderAnsweredAt   DateTime?
  skippedByRecipient Boolean   @default(false)
  skippedAt          DateTime?
  createdAt          DateTime  @default(now())

  question     Question?    @relation(fields: [questionId], references: [id], onDelete: SetNull)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentQuestionSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User         @relation("SentQuestionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([conversationId])
  @@index([senderId])
  @@index([recipientId])
}

// A personal bookmark of a question the user wants to come back to later.
// Private to the user who saved it — never joined into any shared/partner view.
model SavedQuestion {
  id         String   @id @default(uuid())
  userId     String
  questionId String?
  customText String?  @db.Text
  category   String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([questionId])
}

// Per-user "already shown" tracking for the Surprise Me engine, so the same
// question doesn't repeat until the eligible pool has been exhausted.
model SeenQuestion {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  seenAt     DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
}

// A user-composed question (Personalization feature). PRIVATE ones are just a
// personal prompt bank entry; PARTNER ones get delivered into the shared
// conversation — immediately, or later by the scheduler (see
// src/utils/questionScheduler.js) when scheduledFor is set. Only the author
// (and, once delivered, the recipient via the resulting SentQuestion) can ever
// see the content.
model CustomQuestion {
  id             String    @id @default(uuid())
  authorId       String
  recipientId    String?
  conversationId String?
  questionText   String    @db.Text
  category       String?
  ageRestricted  Boolean   @default(false)
  visibility     String    @default("PRIVATE") // PRIVATE | PARTNER
  scheduledFor   DateTime?
  deliveredAt    DateTime?
  sentQuestionId String?   @unique
  createdAt      DateTime  @default(now())

  author    User  @relation("CustomQuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  recipient User? @relation("CustomQuestionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([recipientId])
  @@index([scheduledFor])
}

model Challenge {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  prompt      String   @db.Text
  status      String   @default("PENDING") // PENDING, ACCEPTED, COMPLETED, DECLINED
  createdAt   DateTime @default(now())

  sender    User                @relation("ChallengeSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User                @relation("ChallengeRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  responses ChallengeResponse[]

  @@index([senderId])
  @@index([recipientId])
}

model ChallengeResponse {
  id          String   @id @default(uuid())
  challengeId String
  userId      String
  response    String   @db.Text
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([userId])
}

model GameSession {
  id           String    @id @default(uuid())
  initiatorId  String
  connectionId String
  gameType     String // THIS_OR_THAT, WOULD_YOU_RATHER, WHO_KNOWS_ME_BETTER, TRUTH_OR_DARE
  payload      String    @db.Text // JSON blob: prompt, options, answers
  status       String    @default("ACTIVE") // ACTIVE, COMPLETED
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  initiator User @relation("GameInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)

  @@index([initiatorId])
  @@index([connectionId])
}

model Memory {
  id           String   @id @default(uuid())
  userId       String
  connectionId String?
  title        String
  description  String?  @db.Text
  location     String?
  eventDate    DateTime
  photos       String?  @db.Text // JSON array of URLs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([connectionId])
}

model TimelineEvent {
  id            String   @id @default(uuid())
  userId        String
  connectionId  String?
  title         String
  description   String?  @db.Text
  eventDate     DateTime
  imageUrl      String?
  milestoneType String? // FIRST_CONVERSATION, FIRST_MEETING, FIRST_DATE, ANNIVERSARY, BIRTHDAY, CUSTOM
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([connectionId])
}

model SpecialDate {
  id                String   @id @default(uuid())
  userId            String
  connectionId      String?
  title             String
  date              DateTime
  isRecurringYearly Boolean  @default(false)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  type        String // CONNECTION_REQUEST, CONNECTION_ACCEPTED, NEW_MESSAGE, NEW_LOVE_NOTE, NEW_SECRET_MESSAGE, CHALLENGE_RECEIVED, MEMORY_SHARED
  title       String
  body        String?  @db.Text
  data        String?  @db.Text // JSON blob with related IDs
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
}
