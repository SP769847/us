# Database — MySQL wire protocol (works for local MySQL, TiDB Cloud, PlanetScale).
# Local dev: run `docker compose up -d` at the repo root, then use the URL below.
# TiDB Cloud (production): get this from your cluster's "Connect" panel — it
# looks like mysql://<user>:<password>@<host>:4000/<database>?sslaccept=strict
DATABASE_URL="mysql://us:us_local_dev@localhost:3306/us_dev"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"

# Comma-separated list of allowed frontend origins (no trailing slash).
# Dev example: http://localhost:5173
# Prod example: https://your-app.vercel.app,https://yourdomain.com
CLIENT_URL="http://localhost:5173"

# Supabase Storage — REQUIRED in production. Local disk (the fallback when
# these are blank) does not survive a redeploy/restart on Render, which
# silently breaks every avatar/chat-image/memory-photo/etc. already saved.
# 1. Create a free project at supabase.com
# 2. Storage -> New bucket -> name it "uploads" (or set SUPABASE_STORAGE_BUCKET
#    below to match) -> make it Public
# 3. Project Settings -> API -> copy the Project URL and the service_role key
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# Public URL of the deployed FRONTEND (Vercel) — used to build "Open Chat"
# links inside notification emails/WhatsApp messages. Optional; links are
# simply omitted if unset.
APP_URL=""

# Email notifications (Miss You, waiting-for-reply, new message, connection
# request — all opt-in per user, see Settings > Notifications). Uses Resend's
# HTTP API (https://resend.com) — sign up free, verify a sending domain (or
# use their shared onboarding domain for testing), and copy an API key.
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM=""

# WhatsApp notifications (optional, opt-in + OTP-verified per user) via the
# WhatsApp Business Platform Cloud API — NOT WhatsApp Web automation.
# Requires a Meta Business account + WhatsApp Business app:
#   https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_ACCESS_TOKEN come from that app.
# The three TEMPLATE_NAME vars must match message templates you've created
# and had approved in Meta Business Manager — template content/approval is
# outside this app's control. Every WhatsApp feature no-ops (never crashes,
# never silently pretends to succeed) when these are unset.
WHATSAPP_PROVIDER="meta_cloud_api"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE_NAME="otp_verification"
WHATSAPP_MISS_YOU_TEMPLATE_NAME="miss_you_notification"
WHATSAPP_WAITING_REPLY_TEMPLATE_NAME="waiting_for_reply_notification"
WHATSAPP_CONNECTION_REQUEST_TEMPLATE_NAME="connection_request_notification"

# "I Miss You" / "Waiting for Reply" tuning — all optional, shown defaults
# are used when unset.
MISS_YOU_COOLDOWN_HOURS=6
WAITING_REPLY_DELAY_HOURS=3
WAITING_REPLY_COOLDOWN_HOURS=12
