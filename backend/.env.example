# Database — defaults to local SQLite for zero-setup dev.
# To use Postgres/Supabase: set provider="postgresql" in prisma/schema.prisma and use your
# Supabase connection string here instead.
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# Supabase (optional — only needed if you switch file storage away from local disk)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
