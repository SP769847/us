# Database — Postgres.
# Local dev: run `docker compose up -d` at the repo root, then use the URL below.
# Production (Render): use the "Internal Database URL" from your Render Postgres instance.
# Production (Supabase): use the connection string from Project Settings > Database.
DATABASE_URL="postgresql://us:us_local_dev@localhost:5432/us_dev"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"

# Comma-separated list of allowed frontend origins (no trailing slash).
# Dev example: http://localhost:5173
# Prod example: https://your-app.vercel.app,https://yourdomain.com
CLIENT_URL="http://localhost:5173"

# Supabase (optional — only needed if you switch file storage away from local disk)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
